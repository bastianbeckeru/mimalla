  "courses": [
    {
      "id": 216,
      "name": "Bases Científicas del Funcionamiento Humano",
      "code": "OBS03111",
      "credits": 8,
      "description": "Asignatura que busca comprender la estructura y funciones celulares esenciales para la homeostasis y el manejo de patologías a través de biología celular, química y bioquímica. Utiliza clases participativas, seminarios y evaluaciones de razonamiento subclínico.",
      "duration": 1,
      "prerequisiteCredits": 0,
      "prerequisiteIds": [],
      "corequisiteIds": []
    },
    {
      "id": 217,
      "name": "Cuidados en Salud Mental",
      "code": "OBS03112",
      "credits": 5,
      "description": "Curso que aborda la salud mental, enfocado en el equilibrio entre individuo y entorno sociocultural. Promueve la autorrealización y calidad a lo largo de las etapas de la vida. Clases participativas, análisis de casos clínicos y enfoque de género, con evaluaciones basadas en casos reales y contenido audiovisual.",
      "duration": 1,
      "prerequisiteCredits": 0,
      "prerequisiteIds": [],
      "corequisiteIds": []
    },
    {
      "id": 218,
      "name": "Fundamentos de la Matronería",
      "code": "OBS03113",
      "credits": 10,
      "description": "Curso que presenta una visión general de la carrera. Se enfoca en la promoción, prevención y cuidado integral de la mujer, sexualidad, recién nacidos y educación para la salud. Utiliza clases presenciales, trabajos grupales, exposiciones y evaluaciones con rúbricas de autoevaluación.",
      "duration": 1,
      "prerequisiteCredits": 0,
      "prerequisiteIds": [],
      "corequisiteIds": []
    },
    {
      "id": 219,
      "name": "Salud con Perspectiva de Género",
      "code": "OBS03114",
      "credits": 5,
      "description": "Curso de análisis de cómo los géneros impactan en la salud y enfermedad. Contribuye al perfil de egreso promoviendo un pensamiento crítico y reflexivo sobre la salud actual, enfatizando el respeto, valoración de la individualidad y la diversidad cultural en su futura práctica profesional.",
      "duration": 1,
      "prerequisiteCredits": 0,
      "prerequisiteIds": [],
      "corequisiteIds": []
    },
