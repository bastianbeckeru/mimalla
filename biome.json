{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!drizzle",
      "!.agents",
      "!.worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": { "functions": ["cn", "cva"] }
        }
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        "useImportType": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 500 }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Use the @/* alias" }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "src/components/ui/**"],
      "linter": {
        "rules": { "style": { "noExcessiveLinesPerFile": "off" } }
      }
    },
    {
      "includes": ["src/curriculum/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["./*", "../*"], "message": "Use the @/* alias" },
                  {
                    "group": [
                      "@/builder/**",
                      "@/components/**",
                      "@/stores/**",
                      "@/hooks/**",
                      "@/server/**",
                      "@/app/**"
                    ],
                    "message": "src/curriculum depends on no surface"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
